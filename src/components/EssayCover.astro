---
import VariableMark from './VariableMark.astro';
import { SERIES } from '../lib/series';

interface Props {
  slug: string;
  number: number;
  title: string;
  series: 'truth' | 'beauty' | 'goodness' | 'standalone';
  date: string;
  small?: boolean;
}
const { slug, number, title, series, date, small = false } = Astro.props;
const year = new Date(date).getFullYear();
const seriesLabel = SERIES[series].label;
const paddedNumber = `No. ${String(number).padStart(2, '0')}`;
const long = title.length > 38;
---
<a
  class={`cover-link${small ? ' small' : ''}`}
  href={`/library/${slug}`}
  style={`--series: var(--${series}); --series-ink: var(--${series}-ink);`}
  aria-label={`${title} — ${seriesLabel} series, essay ${number}`}
  transition:name={`cover-${slug}`}
>
  <article class="cover">
    <div class="spine" aria-hidden="true"></div>
    <div class="cover-body">
      <div class="top-band mono">
        <span>THE INDEPENDENT VARIABLE</span>
        <span>{paddedNumber}</span>
      </div>
      <div class="mark-slot">
        <VariableMark series={series} size={small ? 24 : 44} color="var(--series-ink)" />
      </div>
      <h3 class:list={["title", { long }]} transition:name={small ? undefined : `cover-title-${slug}`}>{title}</h3>
      <div class="bottom-line mono">
        <span>{seriesLabel}</span>
        <span>{year}</span>
      </div>
    </div>
    <div class="sheen" aria-hidden="true"></div>
  </article>
</a>

<style>
  .cover-link {
    display: block;
    aspect-ratio: 2 / 3;
    width: 100%;
    border-radius: var(--radius-cover);
  }
  .cover-link.small { max-width: 120px; }

  .cover-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
    border-radius: var(--radius-cover);
  }

  .cover {
    position: relative;
    width: 100%;
    height: 100%;
    background: var(--series);
    color: var(--series-ink);
    border-radius: var(--radius-cover);
    box-shadow: var(--shadow-rest);
    overflow: hidden;
    transform: translateY(0) rotate(0deg);
    transition: transform var(--dur-2) var(--ease-out), box-shadow var(--dur-2) var(--ease-out), opacity 200ms ease-out;
  }

  .cover::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, #FFFFFF0A, transparent 40%, #0000001A);
    pointer-events: none;
  }

  .spine {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 10px;
    background: color-mix(in oklab, var(--series) 88%, black);
  }
  .spine::after {
    content: "";
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 1px;
    background: #FFFFFF14;
  }

  .cover-body {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: var(--space-3) var(--space-4) var(--space-4) calc(10px + var(--space-4));
  }

  .top-band {
    display: flex;
    justify-content: space-between;
    font-size: 0.62rem;
    color: color-mix(in oklab, var(--series-ink) 70%, transparent);
    border-bottom: 1px solid color-mix(in oklab, var(--series-ink) 25%, transparent);
    padding-bottom: var(--space-2);
    letter-spacing: 0.06em;
  }

  .mark-slot {
    display: flex;
    justify-content: center;
    padding-top: 14%;
  }

  .title {
    margin-top: auto;
    font-size: clamp(1.3rem, 2.2vw, 1.9rem);
    line-height: 1.02;
    text-wrap: balance;
    text-align: left;
  }
  .title.long { font-size: clamp(1.05rem, 1.8vw, 1.5rem); }

  .bottom-line {
    display: flex;
    justify-content: space-between;
    margin-top: var(--space-3);
    color: color-mix(in oklab, var(--series-ink) 80%, transparent);
  }

  .sheen {
    position: absolute;
    inset: 0;
    background: linear-gradient(20deg, transparent, #FFFFFF1F, transparent);
    transform: translateX(-120%);
    pointer-events: none;
  }

  .cover-link:hover .cover,
  .cover-link:focus-visible .cover {
    transform: translateY(-10px) rotate(-0.6deg);
    box-shadow: var(--shadow-lift);
  }
  .cover-link:hover .sheen,
  .cover-link:focus-visible .sheen {
    transition: transform 700ms var(--ease-out);
    transform: translateX(120%);
  }
  .cover-link:active .cover {
    transform: translateY(-4px) scale(0.99);
    transition-duration: 80ms;
  }

  .shelf-row:has(.cover-link:hover) .cover-link:not(:hover) .cover {
    opacity: 0.85;
    transition: opacity 200ms ease-out;
  }

  @media (prefers-reduced-motion: reduce) {
    .cover, .sheen { transition: none !important; }
    .cover-link:hover .cover { transform: none; }
  }
</style>
